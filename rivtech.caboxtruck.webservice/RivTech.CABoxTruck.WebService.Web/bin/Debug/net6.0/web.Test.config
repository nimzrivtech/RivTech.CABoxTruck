<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
	<runtime xdt:Transform="InsertIfMissing">
		<gcAllowVeryLargeObjects xdt:Transform="InsertIfMissing" enabled="true" />
	</runtime>
	<location path="." inheritInChildApplications="false">
		<system.webServer>
			<handlers>
				<add xdt:Transform="InsertIfMissing" name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
			</handlers>
			<aspNetCore xdt:Transform="InsertIfMissing" processPath="dotnet" arguments=".\RivTech.CABoxTruck.WebService.dll" stdoutLogEnabled="false" stdoutLogFile="\\?\%home%\LogFiles\stdout" hostingModel="inprocess">
				<environmentVariables xdt:Transform="InsertIfMissing">
					<environmentVariable xdt:Transform="InsertIfMissing" name="ASPNETCORE_ENVIRONMENT" value="Test" />
				</environmentVariables>
			</aspNetCore>
			<httpProtocol xdt:Transform="InsertIfMissing">
				<customHeaders xdt:Transform="InsertIfMissing">
					<remove xdt:Transform="InsertIfMissing" name="X-Powered-By"/>
					<add xdt:Transform="InsertIfMissing" name="Strict-Transport-Security" value="max-age=31536000; includeSubdomains"/>
					<add xdt:Transform="InsertIfMissing" name="Content-Security-Policy" value="default-src 'self';img-src 'self';object-src 'none'; script-src 'self' 'unsafe-inline';style-src 'self' 'unsafe-inline'; upgrade-insecure-requests;" />
				</customHeaders>
			</httpProtocol>
			<security xdt:Transform="InsertIfMissing">
				<requestFiltering removeServerHeader="true" xdt:Transform="InsertIfMissing">
					<requestLimits xdt:Transform="InsertIfMissing" maxAllowedContentLength="1073741824" />
				</requestFiltering>
			</security>
		</system.webServer>
		<system.web xdt:Transform="InsertIfMissing">
			<httpRuntime xdt:Transform="InsertIfMissing" enableVersionHeader="false"/>
		</system.web>
	</location>
</configuration>