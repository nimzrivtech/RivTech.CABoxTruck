  "NLog": {
    "internalLogLevel": "Info",
    "extensions": [
      { "assembly": "NLog.Extensions.Logging" },
      { "assembly": "NLog.Web.AspNetCore" }
    ],
    "targets": {
      "async": true,
      "dbTarget": {
        "type": "database",
        "commandText": "INSERT INTO AppLogs (Application, LogDate, Level, Message, Logger, UserId, Exception) VALUES (@application, @logDate, @Level, @message,@logger, @userId, @exception)",
        "parameters": [
          {
            "name": "@application",
            "layout": "BoxTruck"
          },
          {
            "name": "@logDate",
            "layout": "${date}"
          },
          {
            "name": "@level",
            "layout": "${level}"
          },
          {
            "name": "@message",
            "layout": "${message}"
          },
          {
            "name": "@logger",
            "layout": "${logger}"
          },
          {
            "name": "@userId",
            "layout": "${event-properties:userId}"
          },
          {
            "name": "@exception",
            "layout": "${exception:tostring}"
          }
        ]
      }
    },
    "rules": [
      {
        "logger": "Microsoft.Hosting.Lifetime",
        "minlevel": "Info",
        "final": true,
        "writeTo": "dbTarget"
      },
      {
        "logger": "Microsoft.*",
        "minlevel": "Warn",
        "final": true,
        "writeTo": "dbTarget"
      },
      {
        "logger": "RivTech.*",
        "minlevel": "Trace",
        "final": true,
        "writeTo": "dbTarget"
      },
      {
        "logger": "*",
        "minlevel": "Warn",
        "final": true,
        "writeTo": "dbTarget"
      }
    ]
  },
  "Swagger": {
    "Enabled": "True"
  }
