					CONVERT(DECIMAL(18,2),(
					(coalesce(brpt.[Trailer Premium], 0) + coalesce(brpt.[Hired PD Premium], 0) + coalesce(brpt.[PD Manuscript Premium], 0) +
						coalesce(brpt.[Collision Premium], 0) + coalesce(brpt.[Comp/FT Premium], 0) +
