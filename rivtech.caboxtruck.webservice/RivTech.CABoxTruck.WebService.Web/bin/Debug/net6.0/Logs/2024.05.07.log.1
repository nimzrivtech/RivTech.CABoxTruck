            select RiskId, PolicyHistoryId,SUM(btd.Amount) as totalamount, 'totalnonownedprem'  TransType, CASE WHEN TransactionTypeId='N' THEN 'New' WHEN TransactionTypeId= 'C' THEN 'Cancellation' WHEN TransactionTypeId= 'R'  THEN 'Reinstatement' ELSE 'Endorsement'  END AS TransactionTypeId from Billing_Transaction bt
            join Billing_TransactionDetail btd on bt.Id = btd.TransactionId
            WHERE   (btd.AmountSubTypeId = 'NOTP')
            GROUP BY RiskId, PolicyHistoryId,TransactionTypeId
