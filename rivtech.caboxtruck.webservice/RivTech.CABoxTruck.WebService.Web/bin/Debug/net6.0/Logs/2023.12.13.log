					brpt.[Mailing State] 'MailingState',
					brpt.[Mailing ZipCode] 'MailingZipCode',
					brpt.[Vehicle/Unit Count] 'VehicleUnitCount',
					brpt.[Total Premium] 'TotalPremium',
					brpt.[Auto Liability Premium] 'AutoLiabilityPremium',
