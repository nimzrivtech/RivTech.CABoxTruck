							) totalpdminpremiumadjustment
							cross apply
							(
								select SUM(btd.Amount) as totalamount from Billing_Transaction btt
								join Billing_TransactionDetail btd on btt.Id = btd.TransactionId
								where (btd.AmountSubTypeId = 'PDMMPA') and 
