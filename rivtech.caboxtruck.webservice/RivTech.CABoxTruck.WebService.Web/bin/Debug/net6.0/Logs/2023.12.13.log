            CREATE OR ALTER   PROCEDURE[dbo].[GenerateBorderauxReport]
				@fromDate datetime = NULL,
				@toDate datetime = NULL
			AS
			BEGIN

				DECLARE @reportDate datetime = CONVERT(date, GETDATE())

