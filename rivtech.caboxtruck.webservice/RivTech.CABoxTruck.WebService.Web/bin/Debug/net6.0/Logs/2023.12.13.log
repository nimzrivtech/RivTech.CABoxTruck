											WHEN rpd.[Transaction Type] = 'New' THEN 'N'
											WHEN rpd.[Transaction Type] = 'Cancellation' THEN 'C'
											WHEN rpd.[Transaction Type] = 'Reinstatement' THEN 'R'
											ELSE 'E'
										END
									and
