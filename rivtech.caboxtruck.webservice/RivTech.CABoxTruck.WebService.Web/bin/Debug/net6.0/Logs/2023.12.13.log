					END as varchar(50)), '') as 'CollisionEarnedPremium',
					ISNULL(CAST(CASE WHEN brpt.[Transaction Type] = 'Cancellation' OR brpt.[Transaction Type] = 'Reinstatement'
						THEN NULL
						ELSE brpt.[Comp/FT Earned Premium]
