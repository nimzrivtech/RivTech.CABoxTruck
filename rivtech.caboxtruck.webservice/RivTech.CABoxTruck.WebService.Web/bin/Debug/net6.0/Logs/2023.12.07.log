					(select rr.*
						from
						(
							select 
								r.Id, 
								p.Id as PaymentId,
								r.PolicyNumber,
								ae.CompanyName as Broker,
								ie.CompanyName,
								p.Reference as CheckNumber,
								p.Amount as PaymentAmount,
								p.VoidDate,
								p.CreatedDate as PaymentDate,
								rc.BrokerCommisionAL,
								rc.BrokerCommisionPD,
