FROM [RiskDetail] AS [r]
LEFT JOIN [RiskSpecificRadiusOfOperation] AS [r0] ON [r].[Id] = [r0].[Id]
LEFT JOIN [Insured] AS [i] ON [r].[InsuredId] = [i].[Id]
LEFT JOIN [Entity] AS [e] ON [i].[EntityId] = [e].[Id]
LEFT JOIN [RiskSpecificDriverInfo] AS [r1] ON [r].[Id] = [r1].[Id]
LEFT JOIN [MvrPullingFrequencyOptions] AS [m] ON [r1].[MvrPullingFrequencyId] = [m].[Id]
LEFT JOIN [DriverHeader] AS [d] ON [r].[Id] = [d].[RiskDetailId]
LEFT JOIN [RiskSpecificDriverHiringCriteria] AS [r2] ON [r].[Id] = [r2].[Id]
LEFT JOIN [RiskSpecificDotInfo] AS [r3] ON [r].[Id] = [r3].[Id]
LEFT JOIN [ChameleonIssuesOptions] AS [c] ON [r3].[ChameleonIssuesId] = [c].[Id]
LEFT JOIN [SaferRatingOptions] AS [s] ON [r3].[CurrentSaferRatingId] = [s].[Id]
LEFT JOIN [TrafficLightRatingOptions] AS [t] ON [r3].[IssCabRatingId] = [t].[Id]
LEFT JOIN [RiskSpecificUnderwritingQuestion] AS [r4] ON [r].[Id] = [r4].[Id]
WHERE [r].[Id] = @__id_0
ORDER BY [r].[Id], [r0].[Id], [i].[Id], [e].[Id], [r1].[Id], [m].[Id], [d].[Id], [r2].[Id], [r3].[Id], [c].[Id], [s].[Id], [t].[Id], [r4].[Id]
